{
  "name": "karaoke-gospel",
  "version": "0.1.0",
  "description": "Karaokê Gospel Retrô",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "iniciar": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.5.0",
    "typescript": "5.5.4",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "church.karaoke.gospel",
    "productName": "Karaoke Gospel Retro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
